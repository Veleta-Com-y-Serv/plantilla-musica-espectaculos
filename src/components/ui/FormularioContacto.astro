---
// Formulario sin servidor: si hay email en site.yaml abre el programa de correo (mailto) con los campos en el cuerpo.
// Si no hay email, se queda como muestra y lo avisa. Para un envío real, cambia `action` por el de tu proveedor.
// Campos: nombre, teléfono, email y mensaje. Con `evento` (contratación) pide además la fecha, el tipo de evento
// (desplegable con `tipos`, o texto libre si no hay) y el lugar; sin `evento`, «Me interesa» con los espectáculos.
// `prefijo` hace únicos los ids si hay más de un formulario en la página.
import { site, intereses } from '../../data/site';
interface Props { boton?: string; class?: string; asunto?: string; prefijo?: string; evento?: boolean; tipos?: string[] }
const {
  boton = 'Enviar',
  class: clase = '',
  asunto = `Información desde la web de ${site.nombre}`,
  prefijo = 'f',
  evento = false,
  tipos = [],
} = Astro.props;
const email = site.contacto.email;
const accion = email ? `mailto:${email}?subject=${encodeURIComponent(asunto)}` : '';
const opciones = evento ? [] : intereses();
const id = (campo: string) => `${prefijo}-${campo}`;
---

<form class:list={['formulario', clase]} action={accion || undefined} method="post" enctype="text/plain">
  <div class="campo">
    <label for={id('nombre')}>Nombre</label>
    <input id={id('nombre')} name="nombre" type="text" autocomplete="name" required />
  </div>
  <div class="campo-doble">
    <div class="campo">
      <label for={id('telefono')}>Teléfono</label>
      <input id={id('telefono')} name="telefono" type="tel" autocomplete="tel" inputmode="tel" required />
    </div>
    <div class="campo">
      <label for={id('email')}>Email</label>
      <input id={id('email')} name="email" type="email" autocomplete="email" />
    </div>
  </div>
  {
    evento && (
      <>
        <div class="campo-doble">
          <div class="campo">
            <label for={id('fecha')}>Fecha del evento</label>
            <input id={id('fecha')} name="fecha_evento" type="date" />
          </div>
          <div class="campo">
            <label for={id('tipo')}>Tipo de evento</label>
            {tipos.length > 0 ? (
              <select id={id('tipo')} name="tipo_evento">
                {tipos.map((t) => <option value={t}>{t}</option>)}
              </select>
            ) : (
              <input id={id('tipo')} name="tipo_evento" type="text" />
            )}
          </div>
        </div>
        <div class="campo">
          <label for={id('lugar')}>Lugar y población</label>
          <input id={id('lugar')} name="lugar" type="text" autocomplete="address-level2" />
        </div>
      </>
    )
  }
  {
    opciones.length > 0 && (
      <div class="campo">
        <label for={id('interes')}>Me interesa</label>
        <select id={id('interes')} name="me_interesa">
          {opciones.map((o) => <option value={o}>{o}</option>)}
        </select>
      </div>
    )
  }
  <div class="campo">
    <label for={id('mensaje')}>{evento ? 'Cuéntanos tu fiesta' : 'Mensaje'}</label>
    <textarea id={id('mensaje')} name="mensaje" rows="4"></textarea>
  </div>
  <label class="campo-check">
    <input type="checkbox" name="privacidad" required />
    <span>He leído el <a href="/aviso-legal">aviso legal y la política de privacidad</a>.</span>
  </label>
  <button type="submit" class="btn">{boton}</button>
  <p class="formulario-aviso">
    {
      email
        ? 'Al enviar se abre tu programa de correo con el mensaje listo.'
        : 'Formulario de muestra: todavía no envía mensajes. Usa el teléfono o el email de contacto.'
    }
  </p>
</form>

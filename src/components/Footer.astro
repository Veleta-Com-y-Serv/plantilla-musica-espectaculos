---
// Pie negro a todo el ancho: nombre enorme en hueco magenta de borde a borde y cuatro columnas (la banda y redes,
// contacto, la web y la próxima fecha). «Web creada con NoExpertise» se muestra si site.yaml → marca_pie no es false.
import { site, tel, mapa, whatsapp, proximaFecha } from '../data/site';
import Icono from './ui/Icono.astro';
interface Props { variante?: string }
const { variante = 'noche' } = Astro.props;
const c = site.contacto;
const redes = Object.entries(site.redes).filter(([, url]) => url);
const anio = new Date().getFullYear();
const proxima = proximaFecha();
const hayContacto = c.telefono || c.whatsapp || c.email || c.direccion;
---

<footer class={`pie pie--${variante}`}>
  <div class="pie-cuerpo">
    <div class="contenedor pie-rejilla">
      <div class="pie-marca">
        <p class="pie-nombre">{site.nombre}</p>
        {site.eslogan && <p class="pie-eslogan">{site.eslogan}</p>}
        {
          redes.length > 0 && (
            <ul class="pie-redes">
              {redes.map(([red, url]) => (
                <li>
                  <a href={url} rel="noopener" target="_blank" aria-label={red}>
                    <Icono nombre={red} tam={20} />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
      {
        hayContacto && (
          <div>
            <p class="pie-titulo">Contacto</p>
            <ul class="pie-lista">
              {c.telefono && <li><a href={tel(c.telefono)}>{c.telefono}</a></li>}
              {c.whatsapp && <li><a href={whatsapp(c.whatsapp)} rel="noopener" target="_blank">WhatsApp</a></li>}
              {c.email && <li><a class="break-all" href={`mailto:${c.email}`}>{c.email}</a></li>}
              {c.direccion && <li><a href={mapa(c.direccion)} rel="noopener" target="_blank">{c.direccion}</a></li>}
            </ul>
          </div>
        )
      }
      {
        site.menu.length > 0 && (
          <div>
            <p class="pie-titulo">Web</p>
            <ul class="pie-lista">
              {site.menu.map((e) => <li><a href={e.url}>{e.texto}</a></li>)}
            </ul>
          </div>
        )
      }
      {
        (proxima || c.horario) && (
          <div>
            {proxima && (
              <>
                <p class="pie-titulo">Próxima fecha</p>
                <p class="pie-proxima">{proxima.fecha}</p>
                <p class="opacity-75">{[proxima.lugar, proxima.ciudad].filter(Boolean).join(' · ')}</p>
              </>
            )}
            {c.horario && <p class:list={['text-sm opacity-70', { 'mt-5': proxima }]}>{c.horario}</p>}
          </div>
        )
      }
    </div>
    <p class="contenedor pie-gigante" aria-hidden="true">{site.nombre}</p>
    <div class="contenedor pie-legal">
      <span>© {anio} {site.nombre}</span>
      <a href="/aviso-legal">Aviso legal y privacidad</a>
      {
        site.marca_pie && (
          <span class="pie-noexpertise">
            Web creada con <a href="https://noexpertise.com" rel="noopener">NoExpertise</a>
          </span>
        )
      }
    </div>
  </div>
</footer>

<style>
  .pie-proxima { font-family: var(--fuente-titulos); font-weight: 900; font-synthesis: none; text-transform: uppercase; font-size: 2rem; line-height: 1; color: var(--c-acento); }
</style>

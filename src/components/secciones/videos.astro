---
// Vídeos: `items: [{titulo, texto, duracion, url, imagen}]`. Cada vídeo es una miniatura 16:9 (duotono, a color al
// pasar) con botón de play que abre `url` (YouTube, Vimeo… en otra pestaña; no se incrusta nada). El primero va grande.
// Sin `imagen`, miniatura de noche con trama. Sin `url`, la miniatura no es enlace.
import { seccion, esExterno } from '../../data/site';
import { altFicha } from '../../lib/seo';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const videos = s?.items.filter((v) => v && v.titulo) ?? [];
---

{
  s && (
    <Seccion id={Astro.props.id} banda="oscura" class="videos-banda">
      <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} partido />
      {videos.length > 0 && (
        <ul class:list={['videos', { 'videos--uno': videos.length === 1 }]}>
          {videos.map((v, i) => {
            const Etiqueta = v.url ? 'a' : 'div';
            const enlace = v.url ? { href: v.url, ...(esExterno(v.url) ? { target: '_blank', rel: 'noopener' } : {}), 'aria-label': `Ver el vídeo: ${v.titulo}` } : {};
            return (
              <li class:list={['video', { 'video--grande': i === 0 && videos.length > 1 }]}>
                <Etiqueta class="video-mini" {...enlace}>
                  {v.imagen ? (
                    <span class="video-foto duo">
                      <Imagen src={v.imagen} alt={altFicha(v)} ancho={i === 0 ? 1600 : 800} alto={i === 0 ? 900 : 450} class="h-full w-full object-cover" />
                    </span>
                  ) : (
                    <span class="video-foto video-foto--vacia trama" aria-hidden="true" />
                  )}
                  <span class="video-play" aria-hidden="true"><Icono nombre="play" tam={i === 0 ? 34 : 24} /></span>
                  {v.duracion && <span class="video-duracion mono">{v.duracion}</span>}
                </Etiqueta>
                <div class="video-pie">
                  <h3 class="video-titulo">{v.titulo}</h3>
                  {v.texto && <p class="video-texto">{v.texto}</p>}
                </div>
              </li>
            );
          })}
        </ul>
      )}
      {s.cta && <p class="mt-12"><a class="btn" href={s.cta.url}>{s.cta.texto}</a></p>}
    </Seccion>
  )
}

<style>
  .videos-banda { position: relative; isolation: isolate; overflow: hidden; }
  .videos-banda::before { content: ""; position: absolute; z-index: -1; left: 50%; top: 0; width: 120vw; height: 70%; transform: translateX(-50%); background: radial-gradient(ellipse at top, color-mix(in srgb, var(--c-primario) 32%, transparent), transparent 65%); pointer-events: none; }
  .videos { display: grid; gap: 2rem 1.5rem; }
  @media (min-width: 640px) { .videos { grid-template-columns: repeat(2, minmax(0, 1fr)); } .video--grande { grid-column: 1 / -1; } }
  @media (min-width: 1024px) {
    .videos { grid-template-columns: 2fr 1fr; grid-auto-rows: auto; }
    .video--grande { grid-column: 1; grid-row: span 2; }
    .videos--uno { grid-template-columns: 1fr; }
  }
  @media (min-width: 1024px) { .videos:has(.video:nth-child(4)) { grid-template-columns: 2fr 1fr 1fr; } .videos:has(.video:nth-child(4)) .video--grande { grid-row: span 2; } }
  .video { min-width: 0; }
  .video-mini { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; color: inherit; }
  .video-foto { position: absolute; inset: 0; display: block; }
  .video-foto--vacia { background: var(--noche); }
  .video-play { position: absolute; left: 50%; top: 50%; display: grid; place-items: center; width: 4rem; height: 4rem; border-radius: 50%; background: var(--c-acento); color: var(--sobre-acento); transform: translate(-50%, -50%); box-shadow: 5px 5px 0 var(--c-primario); transition: transform .2s ease; }
  .video-play :global(svg) { fill: currentColor; margin-left: 3px; }
  .video--grande .video-play { width: 5.75rem; height: 5.75rem; }
  a.video-mini:hover .video-play, a.video-mini:focus-visible .video-play { transform: translate(-50%, -50%) scale(1.1); }
  a.video-mini:hover :global(img) { filter: none; mix-blend-mode: normal; }
  .video-duracion { position: absolute; right: .75rem; bottom: .75rem; padding: .2rem .5rem; font-size: .78rem; font-weight: 700; background: var(--c-fondo); color: var(--c-texto); }
  .video-pie { margin-top: 1rem; }
  .video-titulo { font-size: 1.8rem; line-height: 1; }
  .video--grande .video-titulo { font-size: clamp(2rem, 5vw, 3.25rem); }
  .video-texto { margin-top: .35rem; opacity: .75; }
</style>

---
// Preguntas frecuentes sobre papel: titular a la izquierda (fijo al hacer scroll en escritorio) y acordeón nativo
// <details> a la derecha, pregunta en letra de cartel y disco magenta con «+», sin JavaScript.
// Campos: `preguntas[]` (pregunta, respuesta). Sin preguntas no se pinta. También sirve de diseño (`tipo: preguntas`).
import { seccion } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const preguntas = s ? s.preguntas.filter((p) => p && p.pregunta) : [];
---

{
  s && preguntas.length > 0 && (
    <Seccion id={Astro.props.id} banda="papel">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <div class="lg:sticky lg:top-28">
            <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} class="!mb-0" />
          </div>
        </div>
        <div class="faq-lista lg:col-span-7">
          {preguntas.map((p) => (
            <details class="faq">
              <summary>
                <span class="faq-pregunta">{p.pregunta}</span>
                <span class="faq-signo" aria-hidden="true"><span>+</span></span>
              </summary>
              {p.respuesta && <p class="faq-respuesta">{p.respuesta}</p>}
            </details>
          ))}
        </div>
      </div>
    </Seccion>
  )
}

<style>
  .faq-lista { border-top: 3px solid currentColor; }
  .faq { border-bottom: 1px solid color-mix(in srgb, currentColor 30%, transparent); }
  .faq summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 1.25rem; padding-block: 1.35rem; min-height: 3rem; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary:hover .faq-pregunta { color: var(--resalte-texto); }
  .faq-pregunta { font-family: var(--fuente-titulos); font-weight: 900; font-synthesis: none; text-transform: uppercase; font-size: clamp(1.4rem, 3.2vw, 2rem); line-height: 1; transition: color .15s ease; }
  .faq-signo { flex-shrink: 0; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; background: var(--c-primario); color: var(--sobre-primario); font-weight: 800; font-size: 1.6rem; line-height: 1; }
  .faq-signo span { display: block; transition: transform .2s ease; }
  .faq[open] .faq-signo { background: var(--c-fondo); color: var(--c-acento); }
  .faq[open] .faq-signo span { transform: rotate(45deg); }
  .faq-respuesta { padding-bottom: 1.5rem; padding-right: 3.5rem; font-size: 1.08rem; opacity: .85; max-width: 44rem; }
</style>

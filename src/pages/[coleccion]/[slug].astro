---
// Ficha de un elemento con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /espectaculos/<slug>/.
// Diseño «cartel de gira»: banda magenta con trama, migas y hero partido (título de cartel en mayúsculas, texto,
// sellos de formato, duración y precio, botones; a la derecha la foto en duotono o, sin foto, su icono en grande);
// banda papel con el `detalle` y, al lado, la tabla de datos y la caja de contratación sobre noche; galería de
// fotos (`imagenes`) a sangre; y otros espectáculos de la misma lista en banda noche con borde de entrada.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import Titular from '../../components/ui/Titular.astro';
import { seccion, site, tel, whatsapp } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { altGaleria, jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: `/#${f.idSeccion}` },
  { nombre: f.titulo, ruta: f.url },
];
const c = site.contacto;
const contratar = seccion('contratacion') ? '/#contratacion' : site.boton_cabecera?.url || '/#contacto';
const textoContratar = site.boton_cabecera?.texto || 'Pide presupuesto';
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre ${f.titulo}`);
const duracion = f.datos.find((d) => d.clave === 'duracion')?.valor ?? '';
const formato = f.datos.find((d) => d.clave === 'formato')?.valor ?? '';
const datos = f.datos.filter((d) => d.clave !== 'precio');
const otras = relacionadas(f, 3);
const descripcion = resumen(f.texto || f.detalle[0] || '');
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="banda-magenta trama ficha-cabeza">
    <div class="contenedor">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class:list={['ficha-hero', { 'ficha-hero--sin-foto': !f.imagen }]}>
        <div class="ficha-hero-texto">
          <p class="antetitulo">{f.categoria || f.def.nombre}</p>
          <h1 class="titulo-seccion">{f.titulo}</h1>
          {f.texto && <p class="titular-texto">{f.texto}</p>}
          {(formato || duracion || f.precio) && (
            <ul class="ficha-sellos">
              {formato && <li><Icono nombre="usuarios" tam={18} />{formato}</li>}
              {duracion && <li><Icono nombre="reloj" tam={18} />{duracion}</li>}
              {f.precio && <li class="ficha-precio">{f.precio}</li>}
            </ul>
          )}
          <div class="ficha-botones">
            <a class="btn" href={contratar}>{textoContratar}</a>
            {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
          </div>
        </div>
        {f.imagen ? (
          <div class="ficha-foto duo">
            <Imagen src={f.imagen} alt={f.titulo} ancho={1200} alto={900} prioridad class="h-full w-full object-cover" />
          </div>
        ) : (
          <div class="ficha-icono" aria-hidden="true"><Icono nombre={f.icono || 'nota'} tam={110} /></div>
        )}
      </div>
    </div>
  </section>

  <section class="banda-papel ficha-cuerpo-banda">
    <div class="contenedor ficha-cuerpo">
      <article class="texto-largo ficha-detalle">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="ficha-lado">
        {(datos.length > 0 || f.precio) && (
          <div class="ficha-datos">
            <h2 class="ficha-lado-titulo">Ficha técnica</h2>
            <dl>
              {f.precio && <div><dt>Precio</dt><dd class="ficha-precio-dd">{f.precio}</dd></div>}
              {datos.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
            </dl>
          </div>
        )}
        <div class="ficha-cita banda-oscura">
          <p class="ficha-cita-titulo">¿Lo queréis en vuestra fiesta?</p>
          <p>Contadnos la fecha y el lugar y os respondemos con presupuesto.</p>
          <a class="btn" href={contratar}>{textoContratar}</a>
          {c.telefono && <a class="ficha-tel" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
        </div>
      </aside>
    </div>
  </section>

  {f.imagenes.length > 0 && (
    <section class="banda-oscura ficha-galeria-banda" aria-label={`Fotos de ${f.titulo}`}>
      <ul class="ficha-galeria">
        {f.imagenes.map((src, i) => (
          <li class="duo"><Imagen src={src} alt={`${f.titulo}: ${altGaleria(i).toLowerCase()}`} ancho={800} alto={600} class="h-full w-full object-cover" /></li>
        ))}
      </ul>
    </section>
  )}

  {otras.length > 0 && (
    <section class="banda-noche ficha-otras-banda">
      <div class="contenedor">
        <Titular antetitulo={nombreSeccion} titulo={`Otros ${nombreSeccion.toLowerCase()}`} />
        <ul class="ficha-otras">
          {otras.map((o, i) => (
            <li class="ficha-otra">
              <p class="ficha-otra-num hueco" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
              <h3><a href={o.url} class="ficha-otra-enlace">{o.titulo}</a></h3>
              {o.texto && <p class="ficha-otra-texto">{o.texto}</p>}
              <p class="ficha-otra-pie">
                {o.precio && <span class="ficha-precio">{o.precio}</span>}
                <span class="ficha-otra-ver" aria-hidden="true">Ver más <Icono nombre="flecha" tam={16} /></span>
              </p>
            </li>
          ))}
        </ul>
        <p class="mt-10"><a class="btn-sec" href={`/#${f.idSeccion}`}>Ver todos los {nombreSeccion.toLowerCase()}</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .ficha-cabeza { padding-top: 1rem; padding-bottom: clamp(3rem, 6vw, 5rem); }
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .5rem; font-family: var(--fuente-mono); font-size: .78rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .migas li { display: inline-flex; align-items: center; gap: .5rem; min-width: 0; }
  .migas li + li::before { content: "/"; opacity: .6; }
  .migas a { color: inherit; text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; border-bottom: 2px solid transparent; }
  .migas a:hover { border-bottom-color: currentColor; }
  .migas [aria-current] { opacity: .75; overflow-wrap: anywhere; }
  .ficha-hero { display: grid; gap: 2.5rem; margin-top: clamp(1rem, 3vw, 2rem); align-items: center; }
  .ficha-hero-texto .titulo-seccion { font-size: clamp(2.6rem, 11vw, 6.5rem); overflow-wrap: anywhere; line-height: .95; }
  .ficha-sellos { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.5rem; }
  .ficha-sellos li { display: inline-flex; align-items: center; gap: .5rem; padding: .45rem .8rem; font-family: var(--fuente-mono); font-size: .78rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; border: 1.5px solid currentColor; }
  .ficha-sellos .ficha-precio { background: var(--c-acento); color: var(--sobre-acento); border-color: var(--c-acento); }
  .ficha-botones { display: flex; flex-wrap: wrap; gap: 1rem 1.25rem; margin-top: 2rem; padding-right: 6px; }
  .ficha-botones a { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; }
  .ficha-foto { aspect-ratio: 4 / 3; box-shadow: 8px 8px 0 var(--negro); }
  .ficha-icono { display: grid; place-items: center; aspect-ratio: 4 / 3; border: 3px solid currentColor; color: var(--resalte); }
  .ficha-cuerpo-banda { padding-block: clamp(3rem, 7vw, 6rem); }
  .ficha-cuerpo { display: grid; gap: 3rem; }
  .ficha-detalle { max-width: 44rem; font-size: 1.12rem; }
  .ficha-detalle p + p { margin-top: 1.2rem; }
  .ficha-detalle p:first-child { font-size: 1.25rem; font-weight: 600; }
  .ficha-lado { display: grid; gap: 1.5rem; align-content: start; }
  .ficha-lado-titulo { font-family: var(--fuente-mono); font-size: .85rem; letter-spacing: .2em; text-transform: uppercase; margin-bottom: .75rem; }
  .ficha-datos { border: 2px solid currentColor; padding: 1.5rem; }
  .ficha-datos dl { display: grid; }
  .ficha-datos dl > div { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 0; border-top: 1.5px solid color-mix(in srgb, currentColor 25%, transparent); }
  .ficha-datos dt { font-family: var(--fuente-mono); font-size: .78rem; letter-spacing: .1em; text-transform: uppercase; font-weight: 700; opacity: .75; }
  .ficha-datos dd { text-align: right; font-weight: 700; min-width: 0; overflow-wrap: anywhere; }
  .ficha-precio-dd { color: var(--resalte-texto); }
  .ficha-cita { display: grid; gap: .9rem; padding: 1.75rem 1.5rem; box-shadow: 6px 6px 0 var(--c-primario); }
  .ficha-cita-titulo { font-family: var(--fuente-titulos); font-weight: 900; font-synthesis: none; text-transform: uppercase; font-size: 1.9rem; line-height: 1; }
  .ficha-cita .btn { display: inline-flex; align-items: center; justify-content: center; margin-right: 6px; }
  .ficha-tel { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; font-family: var(--fuente-mono); font-weight: 700; letter-spacing: .06em; color: inherit; text-decoration: none; }
  .ficha-galeria { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); }
  .ficha-galeria li { aspect-ratio: 4 / 3; }
  .ficha-otras-banda { padding-block: clamp(3rem, 7vw, 6rem); }
  .ficha-otras { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
  .ficha-otra { position: relative; display: flex; flex-direction: column; gap: .6rem; padding: 1.5rem; border: 2px solid color-mix(in srgb, var(--c-texto) 35%, transparent); transition: border-color .2s ease, transform .2s ease; }
  .ficha-otra:hover { border-color: var(--c-acento); transform: translate(-2px, -2px); }
  .ficha-otra-num { font-family: var(--fuente-titulos); font-weight: 900; font-synthesis: none; font-size: 3.5rem; line-height: .8; }
  .ficha-otra h3 { font-size: clamp(1.7rem, 5vw, 2.2rem); overflow-wrap: anywhere; }
  .ficha-otra-enlace { text-decoration: none; color: inherit; }
  .ficha-otra-enlace::after { content: ""; position: absolute; inset: 0; }
  .ficha-otra-enlace:focus-visible { outline: none; }
  .ficha-otra:has(.ficha-otra-enlace:focus-visible) { outline: 3px solid var(--c-acento); outline-offset: 3px; }
  .ficha-otra-texto { opacity: .85; }
  .ficha-otra-pie { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: .5rem; }
  .ficha-otra .ficha-precio { font-family: var(--fuente-mono); font-weight: 700; color: var(--c-acento); }
  .ficha-otra-ver { display: inline-flex; align-items: center; gap: .3rem; font-family: var(--fuente-mono); font-size: .78rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--c-acento); }
  @media (min-width: 1024px) {
    .ficha-hero { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 4rem; }
    .ficha-cuerpo { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 5rem; align-items: start; }
    .ficha-lado { position: sticky; top: calc(var(--alto-cabecera) + 1.5rem); }
  }
</style>
